---
import Layout from '../layouts/Layout.astro';
import WaterBackground from '../components/WaterBackground/WaterBackground.astro';
import { getPortfolioList } from '../ts/Sanity/sanity';

const contents = await getPortfolioList();
---

<Layout>
	<WaterBackground />
	<nav>
		{contents.map((item) => (
			<a href={`/discover?name=${item.slug.current}`}>{item.title}</a>
		))}
	</nav>
</Layout>
