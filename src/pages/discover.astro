---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { PortfolioApi, urlFor } from '../ts/Sanity';

const slug = Astro.url.searchParams.get('name');

if (!slug) {
  return Astro.redirect('/');
}

const portfolioApi = new PortfolioApi();

let portfolioData;
try {
  const portfolio = await portfolioApi.getBySlug(slug);

  if (!portfolio) {
    return Astro.redirect('/');
  }
  
  portfolioData = portfolio;
} catch (error) {
  console.error('Error fetching portfolio:', error);
  return Astro.redirect('/');
}
---

<Layout
  title={portfolioData.metaTitle}
  metaDescription={portfolioData.metaDescription}
  ogpImage={portfolioData.ogpImage ? urlFor(portfolioData.ogpImage).url() : undefined}
>
  <main>
    <h1>{portfolioData.title}</h1>
    <p>{portfolioData.modalDescription}</p>
  </main>
</Layout>
