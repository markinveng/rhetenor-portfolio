---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getPortfolioBySlug, urlFor } from '../ts/Sanity/sanity';

const slug = Astro.url.searchParams.get('name');

if (!slug) {
  return Astro.redirect('/');
}

let portfolioData;
try {
  const portfolio = await getPortfolioBySlug(slug);

  if (!portfolio) {
    return Astro.redirect('/');
  }
  
  portfolioData = portfolio;
} catch (error) {
  console.error('Error fetching portfolio:', error);
  return Astro.redirect('/');
}
---

<Layout
  title={portfolioData.metaTitle}
  metaDescription={portfolioData.metaDescription}
  ogpImage={urlFor(portfolioData.ogpImage).url()}
>
  <main>
    <h1>{portfolioData.title}</h1>
    <p>{portfolioData.modalDescription}</p>
  </main>
</Layout>
</Layout>
