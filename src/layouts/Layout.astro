---
import { ClientRouter, fade } from 'astro:transitions';
import '../ts/Cursor/Cursor.scss';
import SoundToggle from '../components/SoundToggle/SoundToggle.astro';

interface Props {
  title?: string;
  metaDescription?: string;
  ogpImage?: string;
}

const {
  title = 'Rhetenor',
  metaDescription,
  ogpImage,
} = Astro.props;
---
<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{metaDescription && <meta name="description" content={metaDescription} />}
		{metaDescription && <meta property="og:description" content={metaDescription} />}
		{ogpImage && <meta property="og:image" content={ogpImage} />}
		<meta property="og:title" content={title} />
		<ClientRouter />

		<script>
			/*
			 * astro:before-swapでのApp.destroy()(WorkList/WorkDetailの破棄)が、
			 * WaterBackground/DiscoverGallery等(共有WorldのRendererを破棄する)より
			 * 必ず先に実行されるよう、他のコンポーネントのスクリプトより前に
			 * (<head>内、かつ<slot/>より前に)このリスナーを登録する(main.ts参照)。
			 */
			import "../ts/main";
		</script>
	</head>
	<body transition:animate={fade({ duration: '1.1s' })}>
		<slot />
		<SoundToggle />
	</body>
</html>

<style is:global>
	/*
	 * View Transitionsのold/newスナップショットにtransformが乗って
	 * 位置がズレるのを防ぐ(必ずフェードのみにする)。
	 */
	::view-transition-group(*),
	::view-transition-old(*),
	::view-transition-new(*) {
		transform: none !important;
	}
</style>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
