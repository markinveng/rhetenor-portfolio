---
import type {
  PortfolioSummary,
} from '../../types/portfolio';
import './WorkList.scss';
import './WorkDetail.scss';
import './HoverCursor.scss';

interface Props {
  portfolios: PortfolioSummary[];
}

const { portfolios } = Astro.props;
---

<section
  class="portfolio-canvas"
  data-portfolio-canvas
>
  <div
    class="portfolio-canvas__world"
    data-portfolio-world
  >
    {
      portfolios.map((portfolio, index) => (
        <button
          type="button"
          class="portfolio-canvas__item"
          data-portfolio-item
          data-index={index}
          data-slug={portfolio.slug.current}
          data-title={portfolio.title}
          aria-label={`${portfolio.title}を開く`}
        >
          {
            portfolio.thumbnailMedia?.type === 'img' && (
              <div
                class="portfolio-canvas__media"
                data-portfolio-media
                data-image-ref={
                  portfolio.thumbnailMedia.image.asset._ref
                }
              />
            )
          }

          {
            portfolio.thumbnailMedia?.type === 'vimeo' && (
              <div
                class="portfolio-canvas__media"
                data-portfolio-media
                data-vimeo-url={
                  portfolio.thumbnailMedia.vimeoUrl
                }
              />
            )
          }

          <span class="portfolio-canvas__label">
            + {portfolio.title}
          </span>
        </button>
      ))
    }
  </div>

  <div class="portfolio-canvas__guide">
    Drag to explore
  </div>
</section>

<section
  class="work-detail"
  data-work-detail
  aria-hidden="true"
>
  <div
    class="work-detail__close-zone"
    data-work-detail-close-zone
  ></div>

  <button
    type="button"
    class="work-detail__close"
    data-work-detail-close
    aria-label="閉じる"
  >
    ×
  </button>

  <div class="work-detail__panel" data-work-detail-panel>
    <h2 class="work-detail__title" data-work-detail-title></h2>

    <div class="work-detail__rail" data-work-detail-rail></div>

    <div class="work-detail__scroll" data-work-detail-scroll></div>
  </div>
</section>